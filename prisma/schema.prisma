generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 01 Branches / Филиалы
model Branch {
  id         String    @id
  name       String
  city       String?
  address    String?
  phone      String?
  status     String?
  notes      String?
  openedDate DateTime?
  backpackInventoryIds String[]
  ttcsIds String[]
  budgetAndTargetsIds String[]
  fixedAssetsIds String[]
  buildOutProjectsIds String[]
  marketingCampaignsIds String[]
  documentsIds String[]
  updatedAt  DateTime  @updatedAt
}

// 02 Users / Сотрудники
model User {
  id              String   @id
  fullName        String
  role            String?
  email           String?
  phone           String?
  workingLanguage String?
  status          String?
  branchIds       String[]
  ttcsIds String[]
  programmesCertified String[]
  ttcCompletedDate DateTime?
  teacherLevel String?
  qualificationStatus String?
  updatedAt       DateTime @updatedAt
}

// 03 Courses / Курсы
model Course {
  id              String   @id
  courseName      String
  nameRussian     String?
  nameKyrgyz      String?
  stage           String?
  ageBand         String?
  lessonsPerWeek  Float?
  defaultCapacity Float?
  active          Boolean  @default(false)
  description     String?
  updatedAt       DateTime @updatedAt
}

// 04 Tuition Plans / Тарифные планы
model TuitionPlan {
  id               String   @id
  planName         String
  amount           Float?
  billingPeriod    String?
  active           Boolean  @default(false)
  courseIds        String[]
  nameRussian      String?
  nameKyrgyz       String?
  discount         Boolean  @default(false)
  discountType     String?
  discountValue    Float?
  discountReason   String?
  netAmount        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 05 Terms / Учебные периоды
model Term {
  id          String    @id
  termName    String
  startDate   DateTime?
  endDate     DateTime?
  status      String?
  nameRussian String?
  updatedAt   DateTime  @updatedAt
}

// 06 Rooms / Кабинеты
model Room {
  id          String   @id
  roomName    String
  capacity    Float?
  branchIds   String[]
  nameRussian String?
  updatedAt   DateTime @updatedAt
}

// 07 Leads / Лиды
model Lead {
  id                String    @id
  leadName          String
  inquiryDate       DateTime?
  channel           String?
  childAge          Float?
  preferredLanguage String?
  status            String?
  lostReason        String?
  phone             String?
  whatsapp          String?
  notes             String?
  parentIds         String[]
  branchIds         String[]
  ownerIds          String[]
  lastActivityDate  DateTime?
  referredBy String?
  marketingCampaignsIds String[]
  updatedAt         DateTime  @updatedAt
}

// 08 Trials / Пробные уроки
model Trial {
  id                 String    @id
  trialId            String
  dateTime           DateTime?
  outcome            String?
  notes              String?
  leadIds            String[]
  classGroupIds      String[]
  studentIds         String[]
  confirmationSent   Boolean   @default(false)
  confirmationMethod String?
  confirmationDate   DateTime?
  levelAssessed      String?
  teacherIds         String[]
  enrollmentIds      String[]
  updatedAt          DateTime  @updatedAt
}

// 09 Parents / Родители
model Parent {
  id                    String   @id
  parentName            String
  phone                 String?
  whatsapp              String?
  email                 String?
  preferredLanguage     String?
  address               String?
  notes                 String?
  studentIds            String[]
  branchIds             String[]
  whatsappGroupAdded    Boolean  @default(false)
  whatsappGroupName     String?
  updatedAt             DateTime @updatedAt
}

// 10 Students / Ученики
model Student {
  id           String    @id
  studentName  String
  dateOfBirth  DateTime?
  gender       String?
  status       String?
  notes        String?
  parentIds    String[]
  branchIds    String[]
  medicalNotes String?
  withdrawalDate DateTime?
  reasonForLeaving String?
  pauseReason String?
  firstEnrollDate DateTime?   // rollup — computed in Airtable, never written back
  cohortMonth String?   // formula — computed in Airtable, never written back
  ageAtWithdrawal Float?   // formula — computed in Airtable, never written back
  updatedAt    DateTime  @updatedAt
}

// 11 Class Groups / Группы
model ClassGroup {
  id            String   @id
  groupName     String
  weekdays      String[]
  startTime     String?
  capacity      Float?
  status        String?
  courseIds     String[]
  teacherIds    String[]
  roomIds       String[]
  termIds       String[]
  branchIds     String[]
  enrolledCount Float?   // count — computed in Airtable, never written back
  utilisationPct Float?   // formula — computed in Airtable, never written back
  updatedAt     DateTime @updatedAt
}

// 12 Enrollments / Зачисления
model Enrollment {
  id                            String    @id
  enrollmentId                  String
  enrollDate                    DateTime?
  status                        String?
  studentIds                    String[]
  classGroupIds                 String[]
  tuitionPlanIds                String[]
  branchIds                     String[]
  trialFeeDeducted              Boolean   @default(false)
  contractSigned                Boolean   @default(false)
  contractDate                  DateTime?
  hdSystemRegistered            Boolean   @default(false)
  appCredentialsIssued          Boolean   @default(false)
  scheduleDelivered             Boolean   @default(false)
  calendarDelivered             Boolean   @default(false)
  appInstructionsDelivered      Boolean   @default(false)
  audioRecommendationsDelivered Boolean   @default(false)
  firstLessonConfirmed          Boolean   @default(false)
  firstLessonDate               DateTime?
  onboardingStatus              String?
  nextPaymentDate DateTime?
  endDate DateTime?
  tenureMonths Float?   // formula — computed in Airtable, never written back
  updatedAt                     DateTime  @updatedAt
}

// 13 Sessions / Занятия
model Session {
  id            String    @id
  sessionId     String
  dateTime      DateTime?
  status        String?
  classGroupIds String[]
  teacherIds    String[]
  branchIds     String[]
  updatedAt     DateTime  @updatedAt
}

// 14 Attendance / Посещаемость
model Attendance {
  id           String   @id
  attendanceId String
  status       String?
  sessionIds   String[]
  studentIds   String[]
  updatedAt    DateTime @updatedAt
}

// 15 Invoices / Счета
model Invoice {
  id            String    @id
  invoiceNo     String    @unique
  issueDate     DateTime?
  dueDate       DateTime?
  amount        Float?
  amountPaid    Float?
  status        String?
  parentIds     String[]
  studentIds    String[]
  enrollmentIds String[]
  branchIds     String[]
  amountPaidKgs Float?   // rollup — computed in Airtable, never written back
  balanceKgs Float?   // formula — computed in Airtable, never written back
  updatedAt     DateTime  @updatedAt
}

// 16 Payments / Платежи
model Payment {
  id               String    @id
  paymentRef       String
  date             DateTime?
  amount           Float?
  method           String?
  invoiceIds       String[]
  parentIds        String[]
  branchIds        String[]
  possibleDuplicate Boolean   @default(false)
  paymentType      String?
  updatedAt        DateTime  @updatedAt
}

// 17 Chart of Accounts / План счетов
model Account {
  id          String   @id
  accountNo   String
  accountName String
  nameRussian String?
  type        String?
  subType     String?
  normalSide  String?
  active      Boolean  @default(false)
  notes       String?
  branchIds   String[]
  balanceKgs Float?   // rollup — computed in Airtable, never written back
  updatedAt   DateTime @updatedAt
}

// 18 Journal Entries / Журнальные записи
model JournalEntry {
  id        String    @id
  entryNo   String
  date      DateTime?
  memo      String?
  source    String?
  posted    Boolean   @default(false)
  branchIds String[]
  updatedAt DateTime  @updatedAt
}

// 19 Ledger Lines / Проводки
model LedgerLine {
  id              String   @id
  line            String
  debit           Float?
  credit          Float?
  memo            String?
  journalEntryIds String[]
  accountIds      String[]
  branchIds       String[]
  updatedAt       DateTime @updatedAt
}

// 20 Vendors / Поставщики
model Vendor {
  id          String   @id
  vendorName  String
  category    String?
  phone       String?
  email       String?
  notes       String?
  branchIds   String[]
  nameRussian String?
  fixedAssetsIds String[]
  updatedAt   DateTime @updatedAt
}

// 21 Expenses / Расходы
model Expense {
  id                String    @id
  expenseNo         String
  date              DateTime?
  description       String?
  amount            Float?
  paymentMethod     String?
  paid              Boolean   @default(false)
  notes             String?
  vendorIds         String[]
  expenseAccountIds String[]
  branchIds         String[]
  updatedAt         DateTime  @updatedAt
}

// Application-level approval record for Expenses (stored in PostgreSQL, not Airtable)
model ExpenseApproval {
  id              String    @id
  expenseId       String    @unique
  status          String    @default("Pending Approval") // Pending Approval, Approved, Rejected
  approvedById    String?
  approvedDate    DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 22 Franchise Royalties / Роялти франшизы
model FranchiseRoyalty {
  id                      String    @id
  royaltyNo               String
  period                  DateTime?
  revenueBase             Float?
  royaltyPercent          Float?
  marketingFeePercent     Float?
  status                  String?
  studentsReported        Float?
  activeCoursesReported   Float?
  notes                   String?
  branchIds               String[]
  vendorHQIds             String[]
  fxRateKgsPerEur Float?
  totalDueHqEur Float?   // formula — computed in Airtable, never written back
  updatedAt               DateTime  @updatedAt
}

// 23 Teacher Pay / Оплата преподавателям
model TeacherPay {
  id            String    @id
  payRunNo      String
  period        DateTime?
  payType       String?
  hours         Float?
  rate          Float?
  grossPay      Float?
  paymentMethod String?
  status        String?
  datePaid      DateTime?
  notes         String?
  teacherIds    String[]
  branchIds     String[]
  updatedAt     DateTime  @updatedAt
}

// 24 Teacher Hours / Часы преподавателей
model TeacherHours {
  id         String    @id
  entry      String
  date       DateTime?
  hours      Float?
  type       String?
  notes      String?
  teacherIds String[]
  sessionIds String[]
  branchIds  String[]
  payRunIds  String[]
  updatedAt  DateTime  @updatedAt
}

// 25 Activities / Действия
model Activity {
  id               String    @id
  activityId       String
  dateTime         DateTime?
  type             String?
  direction        String?
  outcome          String?
  notes            String?
  nextFollowUpDate DateTime?
  leadIds          String[]
  ownerIds         String[]
  updatedAt        DateTime  @updatedAt
}

// 26 Channel Performance / Эффективность каналов
model ChannelPerformance {
  id                    String   @id
  rowKey                String
  channel               String?
  month                 String?
  branchIds             String[]
  leads                 Float?
  trialsBooked          Float?
  trialsAttended        Float?
  enrolled              Float?
  lost                  Float?
  lostPrice             Float?
  lostSchedule          Float?
  lostLocation          Float?
  lostWentElsewhere     Float?
  lostNoResponse        Float?
  lostOther             Float?
  updatedAt             DateTime @updatedAt
}

// 27 Notifications Log / Журнал уведомлений
model NotificationLog {
  id             String    @id
  notificationId String
  type           String?
  channel        String?
  status         String?
  scheduledFor   DateTime?
  sentAt         DateTime?
  message        String?
  leadIds        String[]
  parentIds      String[]
  trialIds       String[]
  invoiceIds     String[]
  enrollmentIds  String[]
  branchIds      String[]
  updatedAt      DateTime  @updatedAt
}

// Local security credentials and lockout state for Users
model UserSecret {
  userId        String    @id
  passwordHash  String?   
  loginAttempts Int       @default(0)
  lockoutUntil  DateTime?
  updatedAt     DateTime  @updatedAt
}

// Opaque session tokens (SHA-256 hashed in database)
model UserSession {
  id           String   @id 
  userId       String
  expiresAt    DateTime 
  lastActiveAt DateTime 
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorEmail String   @map("actor_email")  // NOT NULL in DB; use empty string as fallback
  actorRole  String   @map("actor_role")   // NOT NULL in DB
  action     String
  tableName  String   @map("table_name")   // NOT NULL in DB
  recordIds  String?  @map("record_ids")
  fields     String?
  result     String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

// ===========================================================================
// Tables 28–39 — adopted 2026-08-06 (docs/schema-adoption-guide.md §4)
// ===========================================================================

// 28 Backpack Inventory / Инвентарь рюкзаков
model BackpackInventory {
  id                            String @id
  levelName                     String
  totalBackpacks                Float?
  sold                          Float?
  sellingPriceKgs               Float?
  dateReceived                  DateTime?
  supplier                      String?
  purchaseCostKgs               Float?
  notes                         String?
  remaining                     Float?   // formula — computed in Airtable, never written back
  grossProfitPerBackpackKgs     Float?   // formula — computed in Airtable, never written back
  branchIds                     String[]
  relatedServicesRoyalty8PctKgs Float?   // formula — computed in Airtable, never written back
  netProfitPerBackpackKgs       Float?   // formula — computed in Airtable, never written back
  updatedAt                     DateTime @updatedAt
}

// 29 TTCs / Курсы подготовки преподавателей
model Ttc {
  id                   String @id
  ttcId                String
  programme            String?
  startDate            DateTime?
  endDate              DateTime?
  location             String?
  trainer              String?
  participants         Float?
  feePerParticipantKgs Float?
  materialsCostKgs     Float?
  status               String?
  notes                String?
  branchIds            String[]
  teachersTrainedIds   String[]
  totalRevenueKgs      Float?   // formula — computed in Airtable, never written back
  netRevenueKgs        Float?   // formula — computed in Airtable, never written back
  updatedAt            DateTime @updatedAt
}

// 30 Budget &amp; Targets / Бюджет и цели
model BudgetTarget {
  id              String @id
  line            String
  period          DateTime?
  type            String?
  category        String?
  targetAmountKgs Float?
  actualAmountKgs Float?
  notes           String?
  branchIds       String[]
  varianceKgs     Float?   // formula — computed in Airtable, never written back
  variancePct     Float?   // formula — computed in Airtable, never written back
  updatedAt       DateTime @updatedAt
}

// 31 Fixed Assets / Основные средства
model FixedAsset {
  id                         String @id
  asset                      String
  category                   String?
  acquisitionDate            DateTime?
  costKgs                    Float?
  usefulLifeYears            Float?
  accumulatedDepreciationKgs Float?
  status                     String?
  notes                      String?
  branchIds                  String[]
  vendorIds                  String[]
  bookValueKgs               Float?   // formula — computed in Airtable, never written back
  annualDepreciationKgs      Float?   // formula — computed in Airtable, never written back
  buildOutProjectIds         String[]
  updatedAt                  DateTime @updatedAt
}

// 32 Build-Out Projects / Проекты открытия центров
model BuildOutProject {
  id                   String @id
  project              String
  subArea              String?
  type                 String?
  status               String?
  targetOpenDate       DateTime?
  actualOpenDate       DateTime?
  budgetKgs            Float?
  actualSpendKgs       Float?
  notes                String?
  branchIds            String[]
  varianceKgs          Float?   // formula — computed in Airtable, never written back
  fixedAssetsIds       String[]
  subFranchiseesLcfIds String[]
  updatedAt            DateTime @updatedAt
}

// 33 Marketing Campaigns / Маркетинговые кампании
model MarketingCampaign {
  id             String @id
  campaign       String
  channel        String?
  startDate      DateTime?
  endDate        DateTime?
  spendKgs       Float?
  status         String?
  objective      String?
  leadsIds       String[]
  branchIds      String[]
  leadsGenerated Float?   // count — computed in Airtable, never written back
  costPerLeadKgs Float?   // formula — computed in Airtable, never written back
  updatedAt      DateTime @updatedAt
}

// 34 Documents / Документы
model Document {
  id                   String @id
  document             String
  type                 String?
  party                String?
  effectiveDate        DateTime?
  expiry               DateTime?
  status               String?
  notes                String?
  branchIds            String[]
  daysToRenewal        Float?   // formula — computed in Airtable, never written back
  subFranchiseesLcfIds String[]
  updatedAt            DateTime @updatedAt
}

// 35 Sub-Franchisees (LCF/LSF) / Субфранчайзи
model SubFranchisee {
  id                           String @id
  franchiseeName               String
  type                         String?
  subArea                      String?
  populationServed             Float?
  contactName                  String?
  phone                        String?
  email                        String?
  status                       String?
  agreementSignedDate          DateTime?
  openDate                     DateTime?
  gracePeriodEnd               DateTime?
  franchiseFeeEur              Float?
  expectedStudentsRoyaltyBasis Float?
  studentsReported             Float?
  lessonFeeKgs                 Float?
  annualLessonCount            Float?
  royaltyRatePct               Float?
  notes                        String?
  buildOutProjectIds           String[]
  documentsIds                 String[]
  subFranchiseRoyaltiesIds     String[]
  setsIds                      String[]
  actualFixedRoyaltyAnnualKgs  Float?   // formula — computed in Airtable, never written back
  mfFeeShareToHqEur            Float?   // formula — computed in Airtable, never written back
  inGracePeriod                String?   // formula — computed in Airtable, never written back
  updatedAt                    DateTime @updatedAt
}

// 36 Sub-Franchise Royalties / Роялти субфранчайзи
model SubFranchiseRoyalty {
  id                   String @id
  royaltyNo            String
  period               DateTime?
  franchiseeIds        String[]
  monthlyRoyaltyDueKgs Float?
  amountReceivedKgs    Float?
  status               String?
  dueDate              DateTime?
  receivedDate         DateTime?
  hqSharePct           Float?
  notes                String?
  setsIds              String[]
  balanceKgs           Float?   // formula — computed in Airtable, never written back
  hqShareKgs           Float?   // formula — computed in Airtable, never written back
  updatedAt            DateTime @updatedAt
}

// 37 SETs / Самозанятые преподаватели
model SelfEmployedTeacher {
  id                       String @id
  setName                  String
  phone                    String?
  email                    String?
  status                   String?
  reportsToIds             String[]
  students                 Float?
  royaltyRatePct           Float?
  startDate                DateTime?
  notes                    String?
  subFranchiseRoyaltiesIds String[]
  updatedAt                DateTime @updatedAt
}

// 38 Minimum Goals / Минимальные цели
model MinimumGoal {
  id                String @id
  goalYear          String
  schoolYear        String?
  targetStudents    Float?
  startDate         DateTime?
  endDate           DateTime?
  mfOwnedStudents   Float?
  lcf               Float?
  setStudents       Float?
  notes             String?
  totalAreaStudents Float?   // formula — computed in Airtable, never written back
  gapToGoal         Float?   // formula — computed in Airtable, never written back
  pctOfGoal         Float?   // formula — computed in Airtable, never written back
  status            String?   // formula — computed in Airtable, never written back
  updatedAt         DateTime @updatedAt
}

// 39 Franchise Obligations / Обязательства франшизы
model FranchiseObligation {
  id          String @id
  obligation  String
  category    String?
  mfaClause   String?
  cadence     String?
  nextDueDate DateTime?
  amountEur   Float?
  penalty     String?
  status      String?
  notes       String?
  daysToDue   Float?   // formula — computed in Airtable, never written back
  updatedAt   DateTime @updatedAt
}
